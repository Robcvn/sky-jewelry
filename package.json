{
  "name": "sky-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"require('node:fs').rmSync('.next/cache/fetch-cache', { recursive: true, force: true })\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "icons": "node scripts/build-icons.mjs",
    "shopify:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-shopify-seed.mjs",
    "shopify:builder": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-builder-import.mjs",
    "shopify:earrings": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-earrings-import.mjs",
    "images:products": "node scripts/build-product-images.mjs",
    "images:gallery": "node scripts/build-product-images.mjs --gallery"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
