# Shopify Storefront API (see README: Shopify). Copy to .env.local and fill in.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Sanity (see studio/README.md): the editorial content is read at build time from this project and dataset.
# Public values, not secrets (the dataset is public-read; no token is used). Empty: the build uses src/content/.
NEXT_PUBLIC_SANITY_PROJECT_ID=74lb1xq2
NEXT_PUBLIC_SANITY_DATASET=production
# Optional, for checking an import file locally only (a stand-in server answering with it). Leave empty.
SANITY_API_URL=
